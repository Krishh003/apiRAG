# =============================================================================
# API Knowledge Base RAG v2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# --- Required ---

# Google AI Studio API key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j password (must match the password used in docker-compose.yml)
NEO4J_PASSWORD=your_neo4j_password_here

# --- Optional (defaults shown) ---

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# ChromaDB persistent storage directory
CHROMA_PATH=./chroma_db

# Suppress ChromaDB PostHog telemetry errors (harmless but noisy)
ANONYMIZED_TELEMETRY=False

# Scheduled ingestion (APScheduler cron)
# Day of week: mon, tue, wed, thu, fri, sat, sun
SCRAPE_CRON_DAY=sun
# Hour (0-23, Asia/Kolkata timezone)
SCRAPE_CRON_HOUR=2
